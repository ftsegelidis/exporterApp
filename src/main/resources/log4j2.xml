<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
			<PatternLayout pattern="%-5p %c{1} - %m%n"/>
		</Console>
		<RollingFile name="File" fileName="app.log" filePattern="app-%i.log.gz" append="false">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n"/>
			<Policies>
				<SizeBasedTriggeringPolicy size="10 KB"/>
			</Policies>
			<DefaultRolloverStrategy max="5"/>
		</RollingFile>
	</Appenders>
	<Loggers>
		<Logger name="consoleLogger" level="INFO" additivity="false">
			<AppenderRef ref="Console"/>
		</Logger>
		<Logger name="fileLogger" level="DEBUG" additivity="false">
			<AppenderRef ref="File"/>
		</Logger>
		<Root level="DEBUG">
			<AppenderRef ref="Console"/>
			<AppenderRef ref="File"/>
		</Root>
	</Loggers>
</Configuration>
